        let usedCnt = response.data[0]?.usedCnt ?? 0; 
        let leftCount = verifiedCount - usedCnt;
        

             response.data.forEach((ref, index) => {
           if (ref.referred_profile_id) {
            if (!html.includes('<div class="scrollable-list">')) {
              html += `<div class="scrollable-list"><ul class="card__list" style="height:100px; overflow:scroll ;">`;
            }
             html += `
                <li class="card__list_item">
                 <span class="check">
                  <svg class="check_svg" fill="currentColor" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                      <path clip-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z" fill-rule="evenodd"></path>
                    </svg>
                </span>
                 <span>
                    ${ref.referred_profile_id} - 
                    <span style="font-weight: 500; color: ${ref.referred_idv_verified === 'Y' ? 'green' : 'red'};">
                    (${ref.referred_idv_verified === 'Y' ? 'Verified' : 'Not Verified'})
                    </span>
                 </span>
             </li>
             `;
             }
               
            });

             html += `</ul></div>
        <button class="button">Successful Referrals: ${verifiedCount}</button>
        ${session['MEMBER_TYPE'] === "FREE" 
          ? `<button class="button">Credit limits left: ${leftCount}</button>` 
          : ''}
            `;
        document.getElementById("referResults").innerHTML = html;

        let hasVerified = response.data.some(ref => ref.referrer_idv_verified === 'Y');

        const referralCode = document.getElementById("referralCode");
        const lockIcon = document.getElementById("lockIcon");
        const verifyMessage = document.getElementById("verifyMessage");
        const copyIcon = document.getElementById("copyIcon");
        const copyTooltip = document.getElementById("copyTooltip");

        if (referralCode && lockIcon && verifyMessage && copyIcon) {
          if (hasVerified) {
            referralCode.style.filter = 'none';
            referralCode.style.color = '#2c3e50';
            lockIcon.style.display = 'none';
            verifyMessage.style.display = 'none';
            copyIcon.style.display = 'inline';

            setupCopyHandler(copyIcon);

          } else {
            referralCode.style.filter = 'blur(3px)';
            referralCode.style.color = '#aaa';
            lockIcon.style.display = 'inline';
            verifyMessage.style.display = 'block';
            copyIcon.style.display = 'none';
            copyIcon.onclick = null; 
          }
        }
        if (response.data.length > 1) {
          const referredRegId = '';
          $.ajax({
            url: 'Home/referral_alert',
            method: 'POST',
            data: {
              referred_regid: referredRegId,
              count: response.data.length
            },
            success: function (res) {
              console.log("Backend alert response:", res);
            },
            error: function (xhr, status, error) {
              console.error("Failed to notify backend:", error);
            }
          });
        }
      } else {
        document.getElementById("referResults").innerHTML = '<p>No referrals found.</p>';
      }
    },
    error: function () {
      $('#referResults').html('<p>Error loading rewards.</p>');
      $('#referResults').css('display', 'flex').hide().fadeIn();
    }
  });
}
function showCopiedTooltip() {
  if (!copyTooltip) return;
  copyTooltip.style.opacity = 1;
  setTimeout(() => {
    copyTooltip.style.opacity = 0;
  }, 1500);
}

function setupCopyHandler(copyIcon) {
  copyIcon.onclick = function () {
    const message = `find your suitable partner, kindly join Eenadu Pellipandiri using my referral code:  ${profileIdText.trim()}
                    Mobile app Link: https://play.google.com/store/apps/details?id=net.eenadu.pellipandiri`;

    if (navigator.clipboard) {
      navigator.clipboard.writeText(message).then(() => {
        copyIcon.innerText = '✅';
        showCopiedTooltip();
        setTimeout(() => {
          copyIcon.innerText = '📋';
        }, 1500);
      }).catch(err => {
        console.error('Failed to copy text: ', err);
        fallbackCopyTextToClipboard(message);
      });
    } else {
      fallbackCopyTextToClipboard(message);
    }
  };
}


function fallbackCopyTextToClipboard(text) {
  const textArea = document.createElement("textarea");
  textArea.value = text;
  textArea.style.position = "fixed";
  textArea.style.top = 0;
  textArea.style.left = 0;
  textArea.style.width = '2em';
  textArea.style.height = '2em';
  textArea.style.padding = 0;
  textArea.style.border = 'none';
  textArea.style.outline = 'none';
  textArea.style.boxShadow = 'none';
  textArea.style.background = 'transparent';

  document.body.appendChild(textArea);
  textArea.focus();
  textArea.select();

  try {
    const successful = document.execCommand('copy');
    if (successful) {
      showCopiedTooltip();
    } else {
      alert('Press Ctrl+C to copy');  // fallback alert only here
    }
  } catch (err) {
    alert('Oops, unable to copy');
  }

  document.body.removeChild(textArea);
}

function redirectToLogin() {
  $('#staticBackdrop').modal('show');
}

