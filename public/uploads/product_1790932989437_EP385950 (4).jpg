                    data: 'username=' + username,
                    success: function (data) {
                       $('#forgototprequesterr').show();
                       $('#profile_requestotpcount').hide();
                       $('#sec_count').hide();
                       $("#profile_requestotpexpired").hide();
                         $("#profile_requestresendotp").hide();
                      $('#forgototprequesterr').text("OTP Verified Please Wait for login"); 
                       window.location.href = 'https://www.eenadupellipandiri.net/myhome';  
                    }
                });
            }
            


        });
        var otpsend = false;
        $("#otpsubmit").click(function () {

            // alert("otpsubmit");
            var username = $('#username').val();
            getotp(username);
            return true;
            if (username == '') {
                alertmsg("Please Enter Profile ID / Mobile");
                return false;
            }



            else {
                
                // Otp button modification by Surajit

                $(this).prop( "disabled", true );
