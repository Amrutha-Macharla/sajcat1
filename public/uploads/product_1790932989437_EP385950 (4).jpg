        //$('input[name="profile_requestresendotp"]').on('click', function () {
        $('#profile_requestresendotp').on('click', function () {
            var pid = $("#forgot_username").val();
            var moblie = $("#profile_mobile").val();
            var registerid = $("#profile_registerid").val();
            $.ajax({
                type: 'POST',
                url: base_url + 'Profile/reSendforgotOtp',
                data: { 'mobile': moblie, 'regid': registerid , 'pid':pid},
                success: function (data) {

                    alertmsg("otp sent successfully");
                    var splitdata = data.split("~");
                    var otp = splitdata[0];
                    var regid = splitdata[1];
                    var mobno = splitdata[2];
                    $('#profile_registerid').val(regid);

                    $('#profile_otp').val(otp);
                    $('#profile_mobile').val(mobno);

                    $('#otp_dec_count').show();
                    $("#otpsubmit").hide();
                    $("#otpsubmit_new").show();
                    //$('#otpsub').show();
                    $('#forgototprequesterr').show();
                    $("#profile_requestotpexpired").hide();
                    $("#profile_requestotpcount").show();
                    $("#sec_count").show();
                    $('input[name="profile_requestresendotp"]').hide();
                    $("#profile_requestotpcount").html($("#profile_verifycount").val());
                    window.itrval = setInterval(function () {
                        intervalfnreq()
                    }, 1000);
                    //window.location=;
                }
            });
        });

        //  });
        function getotp(username) {
             $("#otpsubmit").hide();
            
            var url = base_url + "Profile/logwotp";
            $.ajax({
                type: 'POST',
                url: url,
                data: 'username=' + username,
                success: function (data) {
                     // alert(data);
                    if((data.trim() == 'Z') || (data.trim() == 'N'))
                    {
                         swal("Profile Not Found","Please Enter Correct Profile ID/Mobile Number","error");
                          $("#otpsubmit").show();

                    }else{

                    $('#forgototprequesterr').text('');
                    var splitdata = data.split("~");
                    var otp = splitdata[0];
                    var regid = splitdata[1];
                    var mobno = splitdata[2];
                    $('#otppassworddis').show();
                    $('#otp_dec_count').show();
                    $('#profile_registerid').val(regid);
                    //  alert(otp);
                    $("#otpsubmit").hide();
                    $("#otpsubmit_new").show();

                    $('#profile_otp').val(otp);
                    $('#profile_mobile').val(mobno);
                    $('#forgototprequesterr').show();
                    $('#forgototprequesterr').text("OTP Sent to your registered mobile number");
                    // $('input[name="profile_resendotp"]').show();
                    $("#profile_requestotpcount").show();
                    $("#sec_count").show();
                    window.itrval = setInterval(function () {
                        intervalfnreq()
                    }, 1000);
                 }

                }
            });

        }

        function checkigotp() {
            var enteredotp = $('#request_otp').val();
            var profileotp = $('#profile_otp').val();
            if (enteredotp == profileotp) {
                //
                $('#forgototprequesterr').hide();
                $("#profile_requestotpcount").hide();
                $("#sec_count").hide();
                $('#otpsubmit').hide();
                $('#otpsubmit_new').show();
                //window.location.href = 'https://www.eenadupellipandiri.net/Login/selectProfilepwd';
            } else {
                alert("Invalid OTP");
                return false;
            }
        }



        // Continuous getting otp fixed by Surajit
        function sendotp() {
           // alert("hi");
            var username = $('#forgot_username').val();
            var url = base_url + "Profile/forgototp";
            $.ajax({
                type: 'POST',
                url: url,
                data: 'username=' + username + '&forgototp=' + "yes",
                success: function (data) {
                    //  alert(data);
                    $('#forgototperr').text('');
                    var splitdata = data.split("~");
                    var otp = splitdata[0];
                    var regid = splitdata[1];
                    var mobno = splitdata[2];
                    $('#otp_dec_count').show();
                    $('#gotp').hide();
                    $('#otpsub').show();
                    $('#profile_registerid').val(regid);
                    $('#profile_otp').val(otp);
                    $('#profile_mobile').val(mobno);
                    $('#forgototperr').text("OTP Sent to your registered mobile number");
                    $('#forgototperr').show();
                    $('input[name="profile_resendotp"]').show();
                    $("#profile_resendotp").hide();
                    $("#profile_otpcount_login").show();
                    $("#sec_count1").show();
                    $("#profile_otpcount_login").html($("#profile_verifycount").val());
                    window.itrval = setInterval(function () {
                        countDownTimer()
                    }, 1000);
                }
            });
        }

    });


$("#forgot_otp").on("keyup", function ()
    {
        var txtVal = this.value; 
        var b = txtVal.replace(/\D+/gi, '');
        $(this).val(b);
    });



