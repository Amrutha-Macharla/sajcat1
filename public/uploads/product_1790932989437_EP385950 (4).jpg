<script>
    function toggleDropdown() {
        const dropdown = document.getElementById("notificationDropdown");
        dropdown.style.display = (dropdown.style.display === "none" || dropdown.style.display === "") ? "block" : "none";
    }

    // document.addEventListener("click", function(event) {
    //     const bell = event.target.closest("li");
    //     const dropdown = document.getElementById("notificationDropdown");

    //     if (!bell || !bell.contains(event.target)) {
    //         dropdown.style.display = "none";
    //     }
    // });

    document.addEventListener("click", function(event) {

    const bell = event.target.closest("li");
    const dropdown = document.getElementById("notificationDropdown");

    if (!dropdown) {
        return;
    }

    if (!bell || !bell.contains(event.target)) {
        dropdown.style.display = "none";
    }

    });
</script>

<script>
const profileIdText = "EP386102";

function toggleReferBox() {
  const box = document.getElementById('referBox1');
  box.style.display = (box.style.display === 'block') ? 'none' : 'block';
   const image = document.getElementById('referLogo');
     image.style.visibility = (image.style.visibility === 'hidden') ? 'visible' : 'hidden';

  $.ajax({
    url: 'https://www.eenadupellipandiri.net/Home/getreferaldetails',
    method: 'GET',
