<style>
input[type="checkbox"] {
          margin-top: 8px;
          width: 24px;
          height: 24px;
          border-radius: 50px;
           background: linear-gradient(white, white) padding-box,
                      linear-gradient(to right top, #f93702, #fd6900, #fe9000, #fdb300, #f9d323) border-box !important;
          border: 2px solid transparent;
          appearance: none;
          cursor: pointer;
          transition: all 0.3s ease;
          position: relative;
        }

        input[type="checkbox"]:checked {
            /* background-image: linear-gradient(to right top, #0dcaf0, #0dcaf0, #0dcaf0, #0dcaf0, #0dcaf0); */
          background-image: linear-gradient(to right top, #f93702, #fd6900, #fe9000, #fdb300, #f9d323) !important;
          border: none;
          animation: circleGrow 0.3s ease-out forwards;
        }

        input[type="checkbox"]:checked::after {
          content: '';
          position: absolute;
          top: 5px;
          left: 9px;
          width: 6px;
          height: 12px;
          border: solid white;
          border-width: 0 2px 2px 0;
          transform: rotate(45deg) scale(0);
          animation: tickGrow 0.3s ease-out forwards;
        }

        @keyframes tickGrow {
          0% {
            transform: rotate(45deg) scale(0);
            opacity: 0;
          }
          50% {
            transform: rotate(45deg) scale(2);
            opacity: 0.8;
          }
          100% {
            transform: rotate(45deg) scale(1);
            opacity: 1;
          }
        }

        @keyframes circleGrow {
          0% {
            transform: scale(0);
            opacity: 0;
          }
          50% {
            transform: scale(2);
            opacity: 0.8;
          }
          100% {
            transform: scale(1);
            opacity: 1;
          }
        }

</style>

