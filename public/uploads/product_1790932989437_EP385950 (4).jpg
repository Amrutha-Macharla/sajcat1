                    if (data.trim() == 'Y') {
                     
                        sendotp();
                       
                    } else if (data.trim() == 'N') {
                    } else if (data.trim() == 'Z'){
                        swal("Profile Not Found","Please Enter Correct Profile ID/Mobile Number","error");
                    }else {
                       swal("","No Profile Found Please Enter Correct Profile ID/Mobile Number","error");
