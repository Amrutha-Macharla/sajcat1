<script>

	

	$("#form_block").submit(function (event) {
		
    event.preventDefault();
    var blar = [];
    var  receiver_register_id = $('#receiver_register_id').val();
    var  sender_register_id = $('#sender_register_id').val();
    //alert(sender_register_id);
     $.each($("input[name = 'bl']:checked"),function(){
     	blar.push($(this).val());
     });
     var bla=blar.length;
     if(bla == 0)
     {
     	alert('Plase Select Atleast One Reason For Blocking');
     	return false;
     }
     var ms = '';
     for(var k=0; k<bla; k++)
     {
     	mm = blar[k];
     	if(mm == 8)
     	{
     	 var blr= $('#blockreason').val();
     	 if(blr=='')
     	 {
     	 	alert('Please Enter the reason');
     	 	return false;
     	 }
     	 else
     	 {
     	 	ms += blr+',';
     	 }
     	}
     	else
     	{
     		 ms += $('#id'+mm).html().trim()+',';
     	}
     	 
     }
     ms = ms.slice(0, -1);
     //ms = ms.replace("'",'');
     $.ajax({
                url :  base_url + "Pchat/block_chat",
                method : "POST",
                data : {'sender_register_id' : sender_register_id, 'receiver_register_id' : receiver_register_id, 'chat_message' : ms},
                success : function(data)
                {
                	alert("successfully blocked");
                }
            });

  });

	$('#decline').click(function(event){
		var  receiver_register_id = $('#receiver_register_id').val();
        var  sender_register_id = $('#sender_register_id').val();
        $.ajax({
                url :  base_url + "Pchat/decline_chat",
                method : "POST",
                data : {'sender_register_id' : receiver_register_id, 'receiver_register_id' : sender_register_id},
                success : function(data)
                {
                	//alert(data);
                }
            });
		
	 });

	$('#accept').click(function(event){
		let acceptBox1 = document.querySelector('.acceptBox');
        acceptBox1.style.backdropFilter='blur(0px)';
        $('#acceptbox').hide();
        var  receiver_register_id = $('#receiver_register_id').val();
        var  sender_register_id = $('#sender_register_id').val();
        $.ajax({
                url :  base_url + "Pchat/accept_chat",
                method : "POST",
                data : {'sender_register_id' : receiver_register_id, 'receiver_register_id' : sender_register_id},
                success : function(data)
                {
                	//alert(data);
                }
            });

       
	});

	function short(t1)
	{
		var ms = t1+1;
		var short_msg=$('#'+ms).html().trim();
		$('#chat_message_area').val(short_msg);
	} 	

 $(document).ready(function () {

 	//$('#form_block').show();
 	$('#dum_dot').hide();
 	var receiver_id;
 	var k = 0;

	//let acceptBox1 = document.querySelector('.acceptBox');
    //acceptBox1.style.backdropFilter='blur(8px)';
    $('#acceptbox').hide();
    

 	setInterval(function(){
            if($('#PersonalMessages').hasClass('show'))
            {	
            	//load_chat();
            	 unreadchat();
            	 load_chat();
            }
            else
            {
                
            }
         },1000); 


	 $('#send_chat').click(function(event){
	 	var  chat_message = $.trim($('#chat_message_area').val());
		// console.log(chat_message);
        var  receiver_register_id = $('#receiver_register_id').val();
        var  receiver_profile_id = $('#receiver_profile_id').val();
        if(chat_message != '')
        {
            $.ajax({
                url :  base_url + "Pchat/send_chat",
                type : "POST",
                data : {'receiver_register_id' : receiver_register_id, 'receiver_profile_id' : receiver_profile_id,    'chat_message' : chat_message},
                beforeSend: function () {
                	const caution = ["photo","PHOTO", "PHONE NO", "PH NO", "phone no", "ph no", "cash", "CASH", "PHONE NUMBER", "PHONE", "phone number","phone", "MONEY", "money"];
                	const arr = chat_message.split(" ");
                	for(var i=0; i < arr.length; i++)
                	{
                		if(caution.includes(arr[i]))
                		{
                			alert("Your Message Consists Of "+ arr[i] + " Term Please Be Cuatious");
                		}
                	}

                },
                success : function(data)
                {
                	if(data != 1)
                	{
                		load_chat();
                		 $('#chat_message_area').val('');
                	}
                }

            });
            
        }
        else
        {
            alert('Type Something in Chat box');
        }
    });

   


     function load_chat()
     { 
     	var receiver_register_id = $('#receiver_register_id').val();
     	var  sender_register_id = $('#sender_register_id').val();
     	var status = 'yes';
    	const caution = ["photo", "phone no", "ph no", "phone", "cash"];
    	var i = 0;
     	 $.ajax({
                url :  base_url + "Pchat/load_chat",
                type : "POST",
                data : {'receiver_register_id' : receiver_register_id, 'chat_message_status' : status},
                dataType : "json",
                success : function(data)
                {
					console.log(data);
                	var html = '';
                	for(var i=0; i < data.length; i++)
                    {

                      	if(data[i].status == 0)
                      	{
                      		  if(data[i].isDecline == 0)
		                      {
		                      	  if(data[i].isAccept == 1)
		                      	  {
		                      	  	$('#acceptbox').hide();
		                      	  	$('#dum_dot').hide();
		                   	  		$('#dum_dot1').show();
		                      	  	if(data[i].receiver_register_id == receiver_register_id)
			                        {
			                            html += '<h6 class="plist-item2">';
			                            html += data[i].message;
			                            if(data[i].pm_status == 1)
			                            	html += '<i class="bi bi-check2-all pdoubleChecks "></i>';
			                            else
			                            	html += '<i class="bi bi-check2 pcheck "></i>';
			                        }
			                        else
			                        {
			                        	 html += '<h6 class="plist-item1">';
			                             html += data[i].message;
			                             
			                        }
			                      	html += '</h6>';
			                      }
			                      else
			                      {
			                      	
			                      	if(data[i].receiver_register_id == sender_register_id)
			                      	{
				                      	$('#acceptbox').show();
				                      	let acceptBox1 = document.querySelector('.acceptBox');
										acceptBox1.style.backdropFilter='blur(8px)';
								    } 
								    else
			                        {
			                        	html += '<h6 class="plist-item2">';
			                            html += data[i].message;
			                            if(data[i].pm_status == 1)
			                            	html += '<i class="bi bi-check2-all pdoubleChecks "></i>';
			                            else
			                            	html += '<i class="bi bi-check2 pcheck "></i>';
			                             
			                        }
			                        html += '</h6>';
			                      }
		                      }

		                      else
		                   	  {
		                   	  	$('#acceptbox').show();
		                   	  	$('#accept').hide();
		                   	  	if(data[i].receiver_register_id == receiver_register_id)
		                   	  	{
		                   	  		let acceptBox1 = document.querySelector('.acceptBox');
										acceptBox1.style.backdropFilter='blur(8px)';
		                   	  		$('#decline').html("your chat was blocked by "+ data[i].receiver_profile_id);
		                   	  		$('#decline').show();
		                   	  		$('#dum_dot').show();
		                   	  		$('#dum_dot1').hide();

		                   	  	}
		                    	if(data[i].sender_register_id == receiver_register_id)
		                    	  {
		                    	  	let acceptBox1 = document.querySelector('.acceptBox');
										acceptBox1.style.backdropFilter='blur(8px)';
		                    		$('#decline').html("you have blocked this chat");
		                    		
		                    		$('#accept').html('You have Declined this chat Click Here To Approve Chat');
		                    		$('#accept').show()	;
		                    		$('#dum_dot').show();
		                   	        $('#dum_dot1').hide();
		                   	        $('#decline').hide();
		                    	  }	
		                    	

		                      } 

		                  }
		                  else
		                  {
		                  		$('#acceptbox').show();
		                   	  	$('#accept').hide();
		                   	  	var blockcount=0;
		                   	  	var profileid;
		                   	  	if(data[i].blockedby == sender_register_id) 
		                   	  	{
		                   	  		if(sender_register_id == data[i].sender_register_id)
		                   	  		{
		                   	  			profileid = data[i].receiver_profile_id;
		                   	  		}
		                   	  		else
		                   	  		{
		                   	  			profileid = data[i].sender_profile_id;
		                   	  		}
		                   	  		let acceptBox1 = document.querySelector('.acceptBox');
										acceptBox1.style.backdropFilter='blur(8px)';
										
		                   	  		$('#decline').html('you have blocked'+'   '+ profileid+ '   '  +  '   ' + ' with  the reason '+ data[i].blocktext + '   ');
									$('#accept').html("unblock");
				                   	$('#accept').show()	;
				                   
		                   	  	}else 
		                   	  	{
		                   	  		if(sender_register_id == data[i].sender_register_id)
		                   	  		{
		                   	  			profileid = data[i].receiver_profile_id;
		                   	  		}
		                   	  		else
		                   	  		{
		                   	  			profileid = data[i].sender_profile_id;
		                   	  		}
		                   	  		let acceptBox1 = document.querySelector('.acceptBox');
										acceptBox1.style.backdropFilter='blur(8px)';
		                   	  		$('#decline').html("you have been blocked by " + profileid +"  with the reason " + data[i].blocktext);
				                }
		                   	  	$('#dum_dot').show();
		                   	  	$('#dum_dot1').hide();
		                   	  	
		                   	  	
		                   	  	

		                  }
                    
                    }
                   
                   
                   	 $('#pMsgView').html(html);
                  
                }

            });
     }	  	

  
  // unreadchat();
  // load_chat();
  
 
 
 });

 

  function unreadchat()
  {
  	var unread = 'unread';
  	var receiver_register_id = $('#receiver_register_id').val();
  	$.ajax({ 
  	
  			url : base_url + "Pchat/unreadchat",
            		type : "POST",
			data : {  'unread' : unread , 'receiver_register_id' : receiver_register_id },
			success : function(data)
            {
				console.log(data);
            	if(data != 1)
            	{
            		const jsp = JSON.parse(data);
            		var html = '';
            		for(var i=0; i < jsp.length; i++)
                    {
                    	var html = '<h6 class=plist-item1>';
                    	html += jsp[i].message;
                    	html += '</h6>';
                    	$('#pMsgView').append(html);
                        
                    }
                     
            	}

            }

  	});	

  	
  }

</script> 
<script>
document.addEventListener('DOMContentLoaded', function () {
  const toggleBtn = document.getElementById('blockToggleBtn');
  const dropdownForm = document.getElementById('form_block');

  // Initially hide the form
  dropdownForm.style.display = 'none';

  toggleBtn.addEventListener('click', function (e) {
    e.stopPropagation(); // Prevent document click from hiding immediately

    // Toggle display and animation class
    if (dropdownForm.style.display === 'none') {
      dropdownForm.style.display = 'block';
      dropdownForm.classList.add('animate-show');
    } else {
      dropdownForm.style.display = 'none';
      dropdownForm.classList.remove('animate-show');
    }
  });

  // Optional: hide dropdown when clicking outside
  document.addEventListener('click', function (e) {
    if (!dropdownForm.contains(e.target) && e.target !== toggleBtn) {
      dropdownForm.style.display = 'none';
      dropdownForm.classList.remove('animate-show');
    }
  });
});
</script>


<div class="modal fade bd-example-modal-lg" id="exp-intrest" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Express Interest</h5>
                <button type="button" class="close clo-btn exp_close" data-dismiss="modal" aria-label="Close">
                    <i class="fa fa-close"></i>
                </button>
            </div>
            <div class="modal-body">

                <div class="row">
                    <form  method="POST" name="expressinterestform" id="expressinterestform">
                        <input type="hidden" id="EIviewtype" name="EIviewtype" value="new">
                        <input type="hidden" id="EIviewid" name="EIviewid" value="">
                        <input type="hidden" id="EIviewprofileid" name="EIviewprofileid" value="">
                        <input type="hidden" id="EItype" name="EItype" value="EI">
                        <input type="hidden" id="EI_org_message_id" name="EI_org_message_id" value="0">
                        <input type="hidden" id="EIisFlag" name="EIisFlag" value="0">
                        <input type="hidden" id="EIfree" name="EIfree" value="0">
                        <div class="col-md-12 text-center">
                            <span>From : <b><span id="EIprofileidfromlabel"></span> </b> &nbsp;</span>
                            <span>To : <b><span id="EIprofileidtolabel"></span></b></span>
                            
                            <ul class="mod-exp-lines">
                                                                    <li><input type="radio" name="expmsg" id="expmsg1" value="I am interested in your profile. If you are interested in my profile, Please contact me."> I am interested in your profile. If you are interested in my profile, Please contact me.</li>
                                                                    <li><input type="radio" name="expmsg" id="expmsg2" value="I have gone through your details and feel we have lot in common. Would like to know your opinion on this"> I have gone through your details and feel we have lot in common. Would like to know your opinion on this</li>
                                                                    <li><input type="radio" name="expmsg" id="expmsg4" value="I found your profile to be a good match for me. Please contact us to proceed further"> I found your profile to be a good match for me. Please contact us to proceed further</li>
                                                                    <li><input type="radio" name="expmsg" id="expmsg5" value="You are the kind of person that we were searching for. Please let me know your opinion"> You are the kind of person that we were searching for. Please let me know your opinion</li>
                                                            </ul>
                            <br>
                            <br>
                        </div>
                        <div class="justify-content-center d-flex">
                        <button type="submit" class="bt_reg" value="Send">Send</button>
                                                <!-- <input class="bt_reg" value="Send" type="submit"> -->
                         <!-- <input class="bt_reg exp_close" data-dismiss="modal" value="Close" type="button"> -->
                         <button type="button" class="bt_reg exp_close" data-dismiss="modal" value="Close">Close</button>
                                </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>


<script>

    $("#expressinterestform").submit(function (event) {
        event.preventDefault();
        var cnt = 0;
        $('#expressinterestform input[type=radio]').each(function () {
            if ($("#" + this.id).prop("checked") == true) {
                cnt++;
            }
        });
        if (cnt == 0) {
            alert("Please select at least one option");
            //$("#expressinteresterr1").show();
            return false;
        }
        var formdata = $("#expressinterestform").serialize();
        var url = base_url + "Psearch/postExpressInterest";
        $.ajax({url: url, data: formdata,type:'POST', beforeSend: function () {
                //$("body").addClass("loading");
            }, complete: function (resp) {
                if (resp.responseText.trim() == 4) {
                    swal('',"You Have Sent Maximum Number Of Interest",'error').then(()=>{
                        var rurl = base_url + "splpackages/home-tab";
                        window.location.replace(rurl);
                    });
                    
                    // $("#expressinteresterr3").show();
                } else  if (resp.responseText.trim() == 3) {
                     $("#exp-intrest").modal('hide');
                      swal('','You have already expressed your interest to this profile','success').then(()=>{
                       location.reload();
                    });
                    
                    // $("#expressinteresterr3").show();
                } else if (resp.responseText.trim() == 1) {
                         // ✅ GET IDS To Send Push Notification
                    const viewerId = "EP386102";
                    const targetId = $("#EIviewprofileid").val();

                    // 🔥 TRIGGER EVENT NOTIFICATION
                    navigator.sendBeacon("/Profile/profile_view_notification", new URLSearchParams({
                        viewer_id: viewerId,
                        viewed_id: targetId,
                        event: "interest_sent"
                    }));

                    $("#exp-intrest").modal('hide');

                    swal('','Express Interest sent Successfully','success').then(()=>{
                        location.reload();
                    });
                    // $("#expressinteresterr4").show();
                } else{
                     $("#exp-intrest").modal('hide');
                      swal('','Something going wrong, Please check','success').then(()=>{
                       location.reload();
                    });
                    
                }
                
                //$("#expressinteresterr2").show();

                // $("body").removeClass("loading");
            }})
    });
</script>


