<script>

document.addEventListener("DOMContentLoaded", function () {

    // 1ï¸âƒ£ Blog submenu lower
    var blogSubNav = document.querySelector(".blog-sub-nav");
    if(blogSubNav){
        blogSubNav.style.position = "relative";
        blogSubNav.style.zIndex = "1";  // Low
    }

    // 2ï¸âƒ£ Main navbar higher
    var mainNavbar = document.querySelector(".navbar");
    if(mainNavbar){
        mainNavbar.style.position = "relative";
        // mainNavbar.style.zIndex = "9999"; // High
    }

    // 3ï¸âƒ£ Main dropdown menu highest
    var dropdownMenu = document.querySelector(".my-nav-dropdown-menu");
    if(dropdownMenu){
        dropdownMenu.style.position = "absolute";
        dropdownMenu.style.zIndex = "99999"; // Top
    }

});


