     <script>
        let hoverTimeout;   
        let isHovered = false;   

        function showDropdown() {
            clearTimeout(hoverTimeout);   
            document.querySelector('.dropdown-menu-logout').style.display = 'block';
            isHovered = true;  
        }

        function startTimer() {
            isHovered = false;
            hoverTimeout = setTimeout(function() {
                if (!isHovered) {
                    document.querySelector('.dropdown-menu-logout').style.display = 'none';
                }
            }, 5000);  
        }

        // document.querySelector('.dropdown-menu-logout').addEventListener('mouseenter', function() {
        //     clearTimeout(hoverTimeout);
        //     isHovered = true;
        // });

        const logoutDropdown = document.querySelector('.dropdown-menu-logout');

        if (logoutDropdown) {

            logoutDropdown.addEventListener('mouseenter', function () {
                clearTimeout(hoverTimeout);
                isHovered = true;
            });

        }

        document.querySelector('.dropdown-menu-logout')?.addEventListener('mouseleave', function() {
    isHovered = false;
    hoverTimeout = setTimeout(() => {
        document.querySelector('.dropdown-menu-logout').style.display = 'none';
    }, 5000);
});
</script> 
<script>
    /* logout button on hove time*/
    let logoutTimer;

    function showLogout() {
        clearTimeout(logoutTimer);
        document.querySelector('.logout-menu').classList.add('show');
    }

    function hideLogoutWithDelay() {
        logoutTimer = setTimeout(() => {
            document.querySelector('.logout-menu').classList.remove('show');
        }, 5000); // 5 sec
    }
</script>

