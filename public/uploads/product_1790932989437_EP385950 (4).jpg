        });
      
        $("#request_otp").change(function () {
           var otpr = $('#request_otp').val();
           var profileotp = $('#profile_otp').val();
            if (otpr.trim() != profileotp.trim()) {
                 $('#forgototprequesterr').show();
                 $('#forgototprequesterr').text("Invalid OTP Please Re enter OTP"); 
            }
            else
            {
              $('#forgototprequesterr').show();
              $('#profile_requestotpcount').hide();
              $('#sec_count').hide();
              $('#forgototprequesterr').text("OTP Verified. Please click on Submit OTP to Login"); 
            }
        });

        $("#otpsubmit_new").click(function () {
            var username = $('#username').val();
             var otpr = $('#request_otp').val();
             var profileotp = $('#profile_otp').val();

             if (username == '') {
                alert("Please Enter PROFILE ID / MOBILE");
                return false;
            }
            if (otpr == '') {
                 alert("Please Enter otp");
                return false;
            }

            if (otpr.trim() != profileotp.trim()) {
                return false;
            }
            else{
                var url = base_url + "Login/otplogin";
                $.ajax({
                    type: 'POST',
