	<script>
		//let acceptBox1 = document.querySelector('.acceptBox');

		//acceptBox1.style.backdropFilter='blur(8px)';

		$("#forwardprofileview").submit(function (event) {
			event.preventDefault();
			var cnt = 0;
			if (cnt == 0) {
				var Fviewid = $("#Fviewid").val();
				var forward_yourname = $("#forward_yourname").val();
				var forward_friendemail = $("#forward_friendemail").val();
				var forward_friendname = $("#forward_friendname").val();

				var formdata = {
					'Fviewid': Fviewid,
					'forward_yourname': forward_yourname,
					'forward_friendemail': forward_friendemail,
					'forward_friendname': forward_friendname
				};
				var url = base_url + "Profile/forwardprofile";
				$.ajax({
					url: url, data: formdata, type: "POST", beforeSend: function () {
						$("body").addClass("loading");
					}, success: function (resp) {
						// alert(resp);
						$("#forward_succ").show();
						$("#forward_friendname").val("");
						$("#forward_friendemail").val("");
						$("body").removeClass("loading");
						$("#print-profil").modal('hide');
					}
				});
			} else {
				return false;
			}



		});



		function getFULLviewaccess(REGID, MEMID, TYPE, FROMMEM) {
			swal({
				title: "",
				text: " Are you sure that you want to request this profile for full view ?",
				icon: "warning",
				buttons: true,
				dangerMode: true,
			}).then((willaccept) => {
				if (willaccept) {
					var toregid = REGID;
					var toprofileid = MEMID;
					var type = TYPE;
					var fromid = FROMMEM;
					var formdata = { 'toregid': toregid, 'toprofileid': toprofileid, 'type': type, 'fromid': fromid };
					var url = base_url + "Search/getFULLviewaccess";
					$.ajax({
						url: url, data: formdata, type: "POST", beforeSend: function () {
							$("body").addClass("loading");
						}, success: function (resp) {
							// Trigger PUsh Notification Full View Request
							var oppuserproid = $("#oppuserproid").val();
									    $.ajax({
									        url: base_url + "Profile/profile_view_notification",
									        type: "POST",
									        data: {
									            viewer_id: "EP386102",
									            viewed_id: oppuserproid,
									            event: "FullView_request"
									        },
									        success: function(res) {
									            console.log("Notification triggered", res);
									        }
									    });
										
							swal("Success", "Full View Request Sent Successfully", "success").then(() => {
								

								location.reload();
							});


						}
					});
				}
				else {
					swal("", "Full View Request Not Sent", "error");
					return false;
				}
			});
		}




		function show_chat(receiver_id, status, pid) {

			url = base_url + "Mmymessages/checkpm";
			var FORMDATA = { 'receiver_register_id': receiver_id, 'receiver_profile_id': pid };
			$.ajax({
				url: url, data: FORMDATA, type: "POST", beforeSend: function () {
					$("body").addClass("loading");

				}, success: function (resp) {
					if (resp == 0) {
						swal('', 'Please Send Express Interest first (or) Wait for acceptance', 'warning');
					}
					else {
						$("#PersonalMessages").modal('show');
						$('#receiver_register_id').val(receiver_id);
						$('#receiver_profile_id').val(pid);
						$('#pid_sec').html(pid);
						$.ajax({
							type: 'POST',
							async: true,
							url: 'https://www.eenadupellipandiri.net/mymessage/getDePhoto',
							data: `rid=${receiver_id}&pid=${pid}`,
							success: function (data) {
								data = JSON.parse(data);
								if (data != 0) {
									$("#pphoto").attr("src", `https://pellipandiri-new-bucket.s3.ap-south-1.amazonaws.com/${data.path}`);
								}
								else {
									// Added By Surajit for get gender
									$.ajax({
										type: 'POST',
										async: true,
										url: 'https://www.eenadupellipandiri.net/mymessage/getGender',
										data: `rid=${receiver_id}&pid=${pid}`,
										success: function (data) {
											// data = JSON.parse(data);
											if (data == 'M') {
												$("#pphoto").attr("src", "https://pellipandiri-new-bucket.s3.ap-south-1.amazonaws.com/assets/images/male.jpg");
											}
											else {
												$("#pphoto").attr("src", "https://pellipandiri-new-bucket.s3.ap-south-1.amazonaws.com/assets/images/female.jpg");
											}
										}
									});

								}
							}
						});
					}

				}
			});


		}

		function getHoroRequest(USERID, TYPE, REQCNT) {
			if (REQCNT >= 1) {
				swal("", "Request already Sent By You", "info").then(() => {
					return false;
				});
			} else
				if (TYPE == 'HR') {
					swal({
						title: "",
						text: "Send request for Horoscope",
						icon: "warning",
						buttons: true,
						dangerMode: true,
					}).then((willaccept) => {
						if (willaccept) {
							var formdata = { 'viewid': USERID, 'viewtype': TYPE };
							var url = base_url + "Search/postUserRequest1";
							$.ajax({
								url: url, data: formdata, type: "POST", beforeSend: function () {
									$("body").addClass("loading");
								}, success: function (resp) {
									if (TYPE == 'HR' && resp.trim() == 4) {
										swal("Request Already Sent");
									}
									if (TYPE == 'HR' && resp.trim() == 1) {

										var oppuserproid = $("#oppuserproid").val();
									    $.ajax({
									        url: base_url + "Profile/profile_view_notification",
									        type: "POST",
									        data: {
									            viewer_id: "EP386102",
									            viewed_id: oppuserproid,
									            event: "horoscope_request"
									        },
									        success: function(res) {
									            console.log("Notification triggered", res);
									        }
									    });



										swal('', 'Your Request Has been sent Please Wait for the reply ', 'success').then((value) => {
											location.reload();
										});

									}
									if (resp.trim() != 4) {
									}
									$("body").removeClass("loading");
								}
							});
						}
						else {
							swal("", "Horoscope Request Not Sent", "error").then((value) => {
								return false;
							});
						}

					});

				}


		}


		function getPhotoRequest(USERID, TYPE, REQCNT) {

			if (REQCNT >= 1) {

				swal("", "Request Already Sent By You", "info").then(() => {
					return false;
				});

			} else
				if (TYPE == 'PHR') {


					swal({
						title: "",
