		<script>
	    $(document).ready(function() {
	        var val = 1;
			// alert(val);
	        console.log('Religion ID:', val);  // Debug output
	        if (val == 1) {
	            $(".Caste").show();
	            $(".Sub_Sect").hide();
	        } else if (val == 2) {
	            $(".Sub_Sect").show();
	            $(".Caste").show();
	        }else if (val == 3) {
	            $(".regview_predenomination").show();
	            $(".Caste").show();
	        }
	    });
	</script>

