    <script>
        $(function() {
            $('ul.nav li.dropdown').hover(function() {
                $(this).find('.dropdown-menu').stop(true, true).delay(200).fadeIn(200);
            }, function() {
                $(this).find('.dropdown-menu').stop(true, true).delay(200).fadeOut(200);
            });
        });
    </script>

    <script>
        /* add active class for dropdown menu li and child */
        $(function($) {
            let url = window.location.href;
            $('nav  ul li a').each(function() {
                if (this.href === url) {
                    $(this).closest('li').addClass('active');
                    $(this).addClass('active');
                }
            });
        });
    </script>
    <script>
        //   namaste btn show hide script

        function pChatShow() {
            var divide = document.querySelector(".Pchat-Box");
            if (divide.style.display === "block") {
                divide.style.display = "none";
            } else {
                divide.style.display = "block";
            }
        }

    
        const mtopbtn = document.querySelector('.topBtnScroll');

        window.addEventListener("scroll", () => {
            if (window.pageYOffset > 50) {
                mtopbtn.classList.add("active");
            } else {
                mtopbtn.classList.remove("active");
            }
        })

        $("#mcName").on("keyup", function() {
            var txtVal = this.value;
            var b = txtVal.replace(/[^a-zA-Z\s]/gi, '');
            $(this).val(b);
        });

        $("#mcMob").on("keyup", function() {
            var txtVal = this.value;
            var k = txtVal.length;
            if(k>10)
            {
                 var b = txtVal.replace(/.$/, '');
                 $(this).val(b);
            }   
            else{
            var b = txtVal.replace(/\D+/, '');
            $(this).val(b);
           }
        });

    
        $("#hcsubmit").click(
            () => {
                event.preventDefault();
                var mcName = $('#mcName').val();
                var mcMob = $('#mcMob').val();
                var formDatas = $("#hcform").serialize();
                if((mcName == '') || (mcMob == ''))
                {
                    swal('',"Please Fill All Required Fields",'').then(()=>{
                        return false;
                    });
                }   
                else{
                // console.log(formDatas );
                $.ajax({
                    type: 'POST',
                    async: true,
                    url: 'https://www.eenadupellipandiri.net/Home/helpCallback',
                    data: formDatas,
                    success: (data) => {
                        var res = data.trim()
                        if (res == 1) {
                           swal('',"Your Call Back request was sent successfully",'').then(()=>{
                                    location.reload();
                           });
                        } else {
                            swal('',"Something Went Wrong Please Try Again",'');
                        }
                    }
                });
              }
            });
        var trsnsImg = $("#trsnsImg");
        var translates = $("#translates");
        var en = $("#en");
        var te = $("#te");
        var ens = $("#ens");
        var tes = $("#tes");
        if (Cookies.get('isLang') == undefined)
        {
            Cookies.set('isLang', "english");
            en.removeClass("tras");
            en.addClass("trasActive");
            ens.removeClass("tras");
            ens.addClass("trasActive");
            te.removeClass("trasActive");
            te.addClass("tras");
            tes.removeClass("trasActive");
            tes.addClass("tras");
        }
        else
        {
            var isLang = Cookies.get('isLang');
            if(isLang == "telugu")
            {
                te.removeClass("tras");
                te.addClass("trasActive");
                tes.removeClass("tras");
                tes.addClass("trasActive");
                en.removeClass("trasActive");
                en.addClass("tras");
