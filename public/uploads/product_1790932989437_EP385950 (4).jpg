		function handleNoHoroRequest(USERID,profileid) {
		    // ✅ Show popup to clicked user
			swal("Horoscope Not Available For This Profile");

		    // ✅ Trigger backend (silent)
		    $.ajax({
					    url: base_url + "Profile/profile_view_notification",
					    type: "POST",
					    data: {
					        viewer_id: "EP386102", // secure
					        viewed_id: profileid,                               // target user
					        event: "horoscope_upload_request"                       // or "horoscope_request"
					    },
					    success: function(res) {
					        console.log("Notification triggered", res);
					    },
					    error: function(err) {
					        console.log("Notification error", err);
					    }
					});

		    return false;
		}
		function handlePhotoNotAvailable(profileid) {

		    swal("Photo not available for this Profile");

		    $.ajax({
		        url: base_url + "Profile/profile_view_notification",
		        type: "POST",
		        data: {
		        	 viewer_id: "EP386102",
		            viewed_id: profileid,
		            event: "photo_upload_request"
		        }
		    });
		}
		function handlePhotoBlocked(profileid) {

		    swal("Opposite user has set his/her account to Private Mode");

		    $.ajax({
		        url: base_url + "Profile/profile_view_notification",
		        type: "POST",
		        data: {
		        	 viewer_id: "EP386102",
		            viewed_id: profileid,
		            event: "photo_hide_attempt"
		        }
		    });
		}
		function handleMobileNoUnlocked(profileid) {

		    swal("Opposite user has set his/her account to Private Mode");

		    $.ajax({
		        url: base_url + "Profile/profile_view_notification",
		        type: "POST",
		        data: {
		        	 viewer_id: "EP386102",
		            viewed_id: profileid,
		            event: "photo_hide_attempt"
		        }
		    });
		}
	</script>

