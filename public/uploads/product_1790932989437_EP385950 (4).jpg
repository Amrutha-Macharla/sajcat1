	<script>
		$(document).ready(function () {
			$('#fvr').hide();
			$('#fvso').hide();
			$('#fvli').hide();
		});
		$(document).ready(function () {
			$('#fvr').hide();
			$('#fvso').hide();
			$('#fvli').hide();
			var emob = $("#emob").val();
			const arremob = emob.split('#');
			var dmob = atob(arremob[1]);
			var eemail = $("#eemail").val();
			const arreemail = eemail.split('#');
			var demail = atob(arreemail[1]);
			var edob = $("#edob").val();
			const arredob = edob.split('#');
			var ddob = atob(arredob[1]);
			var etob = $("#etob").val();
			const arretob = etob.split('#');
			var dtob = atob(arretob[1]);
			var econtper = $("#econtper").val();
			const arrecontper = econtper.split('#');
			var dcontper = atob(arrecontper[1]);
			var efb = $("#efb").val();
			const arrefb = efb.split('#');
			var dfb = atob(arrefb[1]);
			var eld = $("#eld").val();
			const arreld = eld.split('#');
			var dld = atob(arreld[1]);
			var estar = $("#estar").val();
			const arrestar = estar.split('#');
			var dstar = atob(arrestar[1]);
			var eraasi = $("#eraasi").val();
			const arreraasi = eraasi.split('#');
			var draasi = atob(arreraasi[1]);
			$('.elock,.edob,.etob,.slock,.rlock,.phlock,.mblock,.perlock,.mbv,.cont').on('click', function () {

				var memid = $("#memidverify").val();
				if (memid == 'N') {
					swal("", "Please wait while our team evaluates your ID Proofs", "info");
					return false;
				}
				var val = $("#climit").val();
				var regid = $("#regid").val();
				var viewid = $("#viewid").val();
				var oppuserproid = $("#oppuserproid").val();
				var cmemid = $('#cmemid').val();
				var cc = $('#contcount').val();
				var memid = $("#seg").val();
				var mobreq_count = $("#mobreq_count").val();
				var id = $("#id").val();
				var mprivacy1 = $("#mprivacy1").val();
				var mprivacy = $("#mprivacy").val();
				var blck = $("#blck").val();
				var memstatus = $("#memstatus").val();
				if (memstatus == 139 || memstatus == 883) {
					swal("To view more details about this profile, Kindly contact us");
					return false;
				}
				if (blck == 1) {
					swal("");
					return false;
				}
				var value = val - 1;
				var viewid = $("#viewid").val();



				if (val == 0) {
					swal("You Have No Contact Count Left");
				}
				else {


					$("#elock").click(function () {


						$("#det1").hide();
						$("#det").show();

					});
					$("#edob").click(function () {

						$("#dob1").hide();
						$("#dob").show();
					});
					$("#etob").click(function () {
						$("#tob1").hide();
						$("#tob").show();
					});
					$("#slock").click(function () {
						$("#str1").hide();
						$("#str").show();
					});
					$("#rlock").click(function () {
						$("#ras1").hide();
						$("#ras").show();
					});
					$("#phlock").click(function () {

						$("#phn1").hide();
						$("#phn").show();


					});
					$("#mblock").click(function () {

						if (mprivacy == 0) {
							getPhotoRequest(viewid, "PHR", mobreq_count);
						}
						else {
							$("#mbn1").hide();
							// $("#mbn").html("8498969384");
							$("#mbn").show();
						}
					});

					$("#perlock").click(function () {
						$("#cper1").hide();
						$("#cper").show();
					});

					if ((cc == 0) && (mprivacy == 1)) {
						swal({
							// title: "To View More Details About This Profile, Kindly Contact Us",
							title: "Are you sure that you want to unlock this profile?",
							text: "After you unlock, your contact limit will be decrease by 1",
							icon: "warning",
							buttons: true,
							dangerMode: true,
						})
							.then((willDelete) => {
								if (willDelete) {

									newcount1(cmemid, viewid);
									handleMobileNoUnlocked(oppuserproid);
								}
								else {
									//swal("View Contact Cancelled By You");
								}
							});
					}

					if ((cc == 1) && (mprivacy == 1)) {
						$('#mbn,#det,#dob,#tob,#fb,#cper,#str,#lb,#ras').show();
						$('#mbn1,#det1,#dob1,#tob1,#cper1,#fb1,#lb1,#str1,#ras1').hide();

					}

				}

			});
			var mpr = $("#mprivacy").val();
			var cc = $("#contcount").val();
			if ((mpr == 1) && (cc == 1)) {
				$('#mbn,#det,#dob,#tob,#fb,#cper,#str,#lb,#ras').show();
				$('#mbn1,#det1,#dob1,#tob1,#cper1,#fb1,#lb1,#str1,#ras1').hide();
				var cc = $("#contcount").val();
				if (cc == 1) {
					$('#cont,#mbn,#det,#dob,#tob,#cper,#fb,#lb,#str,#ras').html('');
					$('#cont,#mbn').html(dmob);
					$('#det').html(demail);
					$('#dob').html(ddob);
					$('#tob').html(dtob);
					$('#cper').html(dcontper);
					$('#fb').html(dfb);
					$('#lb').html(dld);
					$('#str').html(dstar);
					$('#ras').html(draasi);

				}

			} else {
				$('#mbn,#det,#dob,#tob,#fb,#cper,#str,#lb,#ras').hide();
				$('#mbn1,#det1,#dob1,#tob1,#cper1,#fb1,#lb1,#str1,#ras1').show();

			}

		});


		function newcount1(cmemid, viewid) {
			var url = base_url + "Profile/pcount";
			var req_count = $('#mobreq_count').val();
			var mprivacy = $('#mprivacy').val();
			var emob = $("#emob").val();
			const arremob = emob.split('#');
			var dmob = atob(arremob[1]);
			var eemail = $("#eemail").val();
			const arreemail = eemail.split('#');
			var demail = atob(arreemail[1]);
			var edob = $("#edob").val();
			const arredob = edob.split('#');
			var ddob = atob(arredob[1]);
			var etob = $("#etob").val();
			const arretob = etob.split('#');
			var dtob = atob(arretob[1]);
			var econtper = $("#econtper").val();
			const arrecontper = econtper.split('#');
			var dcontper = atob(arrecontper[1]);
			var efb = $("#efb").val();
			const arrefb = efb.split('#');
			var dfb = atob(arrefb[1]);
			var eld = $("#eld").val();
			const arreld = eld.split('#');
			var dld = atob(arreld[1]);
			var estar = $("#estar").val();
			const arrestar = estar.split('#');
			var dstar = atob(arrestar[1]);
			var eraasi = $("#eraasi").val();
			const arreraasi = eraasi.split('#');
			var draasi = atob(arreraasi[1]);

			var formdata = { 'memid': cmemid, 'viewid': viewid, 'req_count': req_count, 'mprivacy': mprivacy };
			$.ajax({
				url: url, data: formdata, type: "POST", beforeSend: function () {
					$("body").addClass("loading");
				}, success: function (resp) {
					var req_count = $('#mobreq_count').val();
					var mprivacy = $('#mprivacy').val();
					if (resp == 1) {
						if ((mprivacy == 1) && (req_count == 0)) {

							swal("You have Successfully unlocked this profile. Site is Reloading...");
							$('#mbn,#det,#dob,#tob,#fb,#cper,#str,#lb,#ras').show();
							$('#mbn1,#det1,#dob1,#tob1,#cper1,#fb1,#lb1,#str1,#ras1').hide();
							var cc = $("#contcount").val();
							if (cc == 1 || cc == 0) {
								$('#cont,#mbn,#det,#dob,#tob,#cper,#fb,#lb,#str,#ras').html('');
								$('#cont,#mbn').html(dmob);
								$('#det').html(demail);
								$('#dob').html(ddob);
								$('#tob').html(dtob);
								$('#cper').html(dcontper);
								$('#fb').html(dfb);
								$('#lb').html(dld);
								$('#str').html(dstar);
								$('#ras').html(draasi);
								location.reload();
							}
						}
						else {
							swal("Request sent Successfully");
						}
					}
					else
						if (resp == 3) {
							if ((mprivacy == 1) && (req_count == 0)) {
								//alert("You");
							}
							else {
								swal("Request already Sent By You");
							}
						}


				}
			});
		}
		function fv() {

			$('#fvr').show();
			$('#fvso').show();
			$('#fvli').show();
			$('#fvb').hide();
		}
		function whatsapp() {
			var pr_id = $('#pr_id').val();
			var pr_pid = $('#pr_pid').val();
			var ph_no = $('#ph_no').val();
			if (ph_no == '') {
				swal("", "Please Enter Mobile Number", "info");
				return false;
				$('#ph_no').focus();
			}
			var ur = "https://www.eenadupellipandiri.net/viewprofilewp/" + pr_id + "/" + pr_pid;
			var eurl = encodeURI(ur);
			var url = "https://wa.me/" + "+91" + ph_no + "?text="
				+ "*Profile Id   :* " + pr_pid + "%0a"
				+ "*Url   :* " + eurl;

			window.open(url, '_blank').focus();
		}

		function myFroward() {

			document.getElementById("myFrowardbox").style.display = "block";

			document.getElementById("mySharebox").style.display = "none";

			document.getElementById("myProprint").style.display = "none";



		}

		function myShare() {

			document.getElementById("myFrowardbox").style.display = "none";

			document.getElementById("mySharebox").style.display = "block";

			document.getElementById("myProprint").style.display = "none";


		}

		function myProprint() {

			document.getElementById("myFrowardbox").style.display = "none";

			document.getElementById("mySharebox").style.display = "none";

			document.getElementById("myProprint").style.display = "block";



		}

		//chatbox js
		const pchatbox = document.getElementById('p-chatbox');
