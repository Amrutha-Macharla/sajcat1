c02\u0c1a\u0c3f \u0c05\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u200c\u0c28\u0c3f \u0c24\u0c40\u0c38\u0c3f\u0c35\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f UEPL \u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c02 \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c05\u0c32\u0c3e\u0c17\u0c47, UEPL \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32 \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02 \u0c38\u0c48\u0c1f\u0c4d\u200c\u0c15\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c05\u0c2f\u0c3f\u0c28 \u0c06\u0c15\u0c4d\u0c37\u0c47\u0c2a\u0c23\u0c40\u0c2f \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c4d\u0c28 \u0c38\u0c2d\u0c4d\u0c2f\u0c24\u0c4d\u0c35 \u0c16\u0c3e\u0c24\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.","uganda":"\u0c09\u0c17\u0c3e\u0c02\u0c21\u0c3e","uige":"\u0c0a\u0c1c\u0c4d","ukraine":"\u0c09\u0c15\u0c4d\u0c30\u0c46\u0c2f\u0c3f\u0c28\u0c4d","ulaanbaatar":"\u0c09\u0c32\u0c3e\u0c28\u0c4d\u200c\u0c2c\u0c3e\u0c24\u0c30\u0c4d","umm salal":"\u0c09\u0c2e\u0c4d \u0c38\u0c3e\u0c32\u0c32\u0c4d","unblock":"\u0c05\u0c28\u0c4d\u200c\u0c2c\u0c4d\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","uncle\/aunty":"\u0c05\u0c02\u0c15\u0c41\u0c32\u0c4d\u200c\/\u0c06\u0c02\u0c1f\u0c40","ungheni":"\u0c09\u0c28\u0c4d\u0c18\u0c47\u0c28\u0c3f","unhide photo":"\u0c2b\u0c4b\u0c1f\u0c4b\u0c28\u0c41 \u0c26\u0c3e\u0c1a\u0c3f\u0c2a\u0c46\u0c1f\u0c4d\u0c1f\u0c41","united arab emirates":"\u0c2f\u0c42\u0c0f\u0c08","united kingdom":"\u0c2f\u0c42\u0c15\u0c47","university details":"\u0c2f\u0c42\u0c28\u0c3f\u0c35\u0c30\u0c4d\u0c38\u0c3f\u0c1f\u0c40 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41","unlock":"\u0c05\u0c28\u0c4d\u200c\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c