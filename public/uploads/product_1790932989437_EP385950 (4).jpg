    <script>

    var membership = "FREE";
    var memstatus = "1";

    const packageAlert = document.getElementById("packageExpiryAlert");
    const header = document.getElementById("header001");

    if (memstatus && packageAlert && header) {

        packageAlert.onclick = function () {

            header.style.marginTop = "0px";

            Cookies.set('dismissed', true, {
                expires: 1
            });
        };
    }

    if (membership == 'PAID' && packageAlert && header) {

        if (Cookies.get('dismissed') && memstatus) {

            packageAlert.classList.remove("show");
            packageAlert.classList.add("hide");
        }

        if (Cookies.get('dismissed') == undefined && memstatus) {

            setTimeout(function () {
                header.style.marginTop = "58px";
            }, 5000);
        }
    }

</script>
   
    <script type="text/javascript">
       
       jQuery(function($) {
            var path = window.location.href;
            var segments = window.location.pathname.split('/').filter(Boolean);
            
            $('.navbar-expand-lg .navbar-nav .nav-link').each(function() {
                if (this.href === path) {
                    $(this).addClass('menuactive');
                }
            });
        
            if (segments[0] === 'membership-plans' || segments[0] === 'membership-plans') {
                $('.navbar-expand-lg .navbar-nav .nav-link[href*="membership-plans"]').addClass('menuactive');
            }
        });
