<!-- push Notification firebase intigration DONT REMOVE IT -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getMessaging, getToken, onMessage } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-messaging.js";

async function startFirebasePush() {
    try {
        // 1️⃣ Fetch Firebase config + VAPID key from backend
        const res = await fetch('/eppservices/api_app/getFirebaseConfig'); // update URL as needed
        const data = await res.json();

        if (!data.status || !data.config) {
            console.log("Firebase config not available or user not logged in");
            return;
        }

        const firebaseConfig = {
            apiKey: data.config.apiKey,
            authDomain: data.config.authDomain,
            projectId: data.config.projectId,
            messagingSenderId: data.config.messagingSenderId,
            appId: data.config.appId
        };

        const vapidKey = data.config.vapidKey;

        // 2️⃣ Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const messaging = getMessaging(app);

        // 3️⃣ Request notification permission
        const permission = await Notification.requestPermission();
        if (permission !== "granted") {
            console.log("Notification permission denied");
            return;
        }

        // 4️⃣ Register service worker
        // const registration = await navigator.serviceWorker.register('/firebase-messaging-sw.js');

        const registration = await navigator.serviceWorker.register(
    '/firebase-messaging-sw.js',
    {
        updateViaCache: 'none'
    }
);

await registration.update();

if (registration.waiting) {
    registration.waiting.postMessage("SKIP_WAITING");
}

navigator.serviceWorker.addEventListener('controllerchange', () => {
    window.location.reload();
});

        // 5️⃣ Get token
        const token = await getToken(messaging, {
            vapidKey,
            serviceWorkerRegistration: registration
        });
        // console.log('token :',token);
        if (!token) {
            console.log("Unable to get FCM token");
            return;
        }

        localStorage.setItem("fcm_token", token);

        // 6️⃣ Send token to backend
        const profileId = "EP386102";
        if (!profileId) {
            console.log("User not logged in, skipping token save");
            return;
        }
        // console.log(token);
        const formData = new URLSearchParams();
        formData.append("profile_id", profileId);
        formData.append("fcm_token", token);
        formData.append("device_type", "web");
        formData.append("device_name", navigator.userAgent);

        await fetch('/eppservices/api_app/saveDeviceToken', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData
        });

        // 7️⃣ Handle foreground messages
        // onMessage(messaging, payload => {
        //     if (Notification.permission === "granted") {
        //         new Notification(payload.data.title, {
        //             body: payload.data.body,
        //             icon: payload.data.icon
        //         });
        //     }
        // });

        // onMessage(messaging, payload => {

        // console.log("Foreground message:", payload);

        // // only refresh notification list
        // loadNotifications();

        // });

    } catch (err) {
        console.error("FCM ERROR:", err);
    }
}

startFirebasePush();
</script>

<script>

    let soundAllowed = false;

    document.addEventListener("click", function initAudio() {
        const audio = document.getElementById("notifSound");
        audio.play().catch(() => {}); // allow browser to unlock audio
        audio.pause();
        audio.currentTime = 0;
        soundAllowed = true;
        document.removeEventListener("click", initAudio);
    });

function openNotifications() {
let modal = document.getElementById("notifModal");
modal.style.display = (modal.style.display === "block") ? "none" : "block";
}

function closeNotifications() {
    document.getElementById("notifModal").style.display = "none";
}
const profileId = "EP386102";

// 🔔 OPEN MODAL
let notifOpen = false;
let lastUnreadCount = 0;

function openNotifications() {
    const modal = document.getElementById("notifModal");

    notifOpen = !notifOpen;
    modal.style.display = notifOpen ? "block" : "none";

    if (notifOpen) {
        loadNotifications(true);

        // mark all as read
        fetch("/Profile/mark_notifications_read", {
            method: "POST",
            headers: {"Content-Type": "application/x-www-form-urlencoded"},
            body: "profile_id=" + profileId
        });

        document.getElementById("notifCount").style.display = "none";
    }
}

function closeNotifications() {
    document.getElementById("notifModal").style.display = "none";
    notifOpen = false;
}

// 🔥 LOAD DATA
async function loadNotifications() {

    const res = await fetch(`/Profile/get_notifications?profile_id=${profileId}`);
    const data = await res.json();
    // console.log("data : ", data);
    const box = document.getElementById("notifList");
    box.innerHTML = "";

    let unreadCount = 0;

    data.forEach(n => {

        if (n.is_read == 0) unreadCount++;

     box.innerHTML += `
                    <div class="notif-item ${n.is_read == 0 ? 'unread' : ''}" 
                        onclick="onNotifClick(${n.id}, this, '${n.template}', '${n.target_profile_id}', '${n.target_register_id}')">
                        
                        <div class="notif-row">

                            <div class="notif-content">
                                <div class="notif-title">${n.title}</div>
                                <div class="notif-text">${n.message}</div>
                                <div class="notif-time">${formatTime(n.created_at)}</div>
                            </div>

                        </div>
                    </div>
                    `;
    });

    // 🔴 BADGE
    const badge = document.getElementById("notifCount");

    const previousCount = parseInt(document.getElementById("notifCount").innerText) || 0;
    if (unreadCount > previousCount) {
        playNotificationSound();
    }

    if (unreadCount > 0) {
            badge.innerText = unreadCount;
            badge.style.display = "inline-block";

            // 🔊 play sound if new notifications
            if (unreadCount > lastUnreadCount) {
                document.getElementById("notifSound")?.play();
            }

        } else {
            badge.style.display = "none";
        }

        lastUnreadCount = unreadCount;
}

// 🔄 AUTO REFRESH
// setInterval(loadNotifications, 10000);

// INITIAL LOAD
loadNotifications();

document.addEventListener("click", function(e) {
    let modal = document.getElementById("notifModal");
    if (!modal.contains(e.target) && !e.target.closest('[onclick="openNotifications()"]')) {
        modal.style.display = "none";
    }
});
function readSingle(id, el) {

    fetch("/Profile/read_single_notification", {
        method: "POST",
        headers: {"Content-Type": "application/x-www-form-urlencoded"},
        body: "id=" + id
    });

    el.classList.remove("unread");
}
function formatTime(time) {
    const now = new Date();
    const past = new Date(time);
    const diff = Math.floor((now - past) / 1000);

    if (diff < 60) return "Just now";
    if (diff < 3600) return Math.floor(diff/60) + " min ago";
    if (diff < 86400) return Math.floor(diff/3600) + " hrs ago";
    return Math.floor(diff/86400) + " days ago";
}

function handleNotificationClick(template, target_profile_id, target_register_id) {

    let url = "/";

    // 🎯 ROUTING LOGIC
    if (template === "profile_view") {
        url = "/viewprofile/" + target_register_id + "/" + target_profile_id;
    } 
    else if (template === "interest_sent") {
        url = "/mymessages/expressinterestreceived"; 
    } 
    else if (template === "message_received") {
        url = "/chat"; 
    }else if (template === "interest_accepted") {
        url = "/mymessages/expressinterestreceived";  
    }

    window.location.href = url;
}
function onNotifClick(id, el, template, target_profile_id, target_register_id) {

    // ✅ mark as read
    readSingle(id, el);

    // ✅ safe values
    template = template || "";
    target_profile_id = target_profile_id || "";
    target_register_id = target_register_id || "";

    // ✅ smooth redirect
    setTimeout(() => {
        handleNotificationClick(template, target_profile_id, target_register_id);
    }, 100);
}
function playNotificationSound() {
    if (!soundAllowed) return; // skip if audio not yet allowed

    const audio = document.getElementById("notifSound");
    audio.currentTime = 0;
    audio.play().catch(err => console.log("Sound blocked:", err));
}
