                    $('input[name="forgot_otp"]').val('');
                    $('input[name="forgot_otp"]').show();
                    $('input[name="setnewpassword"]').val('');
                    $('input[name="setnewpassword"]').show();
                    $('#setnewpassword').show();
                    //$('#setnewpassword').show();
                    $('#otpsub').show();
                    $("#profile_otpexpired").hide();
                    $("#profile_resendotp").hide();
                    $("#profile_otpcount_login").show();
                    $("#sec_count1").show();
                    $('input[name="profile_resendotp"]').hide();
                     $('#forgototperr').text();
