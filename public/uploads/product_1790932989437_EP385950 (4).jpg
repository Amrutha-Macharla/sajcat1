<script>
    function myFunction() {
        var x = document.getElementById("pwd");
        if (x.type === "password") {
            x.type = "text";
        } else {
            x.type = "password";
        }
    }
    

    function countDownTimer() {
        if (parseInt($("#profile_otpcount_login").html()) != 0) {
            $("#profile_otpcount_login").html(parseInt($("#profile_otpcount_login").html()) - 1);


        } else {
            $('#forgototperr').hide();
            var url = $("#profile_baseurl").val() + "Profile/expireOtp";
            var formdata = { "regid": $("#profile_registerid").val(), "eotp": $("#profile_eotp").val(), "otp": $('#profile_otp').val() };
            $.ajax({
                url: url, data: formdata, type: "POST", complete: function (resp) {
                    $("#profile_resendotp").show();
                    $("#profile_otpexpired").show();
                    $("#profile_otpcount_login").hide();
                    $("#sec_count1").hide();
                    $("#profile_eotp").val("");
                    window.clearInterval(itrval);
                    itrval = false;
                }
            });
        }
    }

     function newfun() {
            var username = $('#username').val();
            var pwd = $('#pwd').val();
            if (username == '') {

                //alert('Please Enter PROFILE ID / MOBILE / EMAIL');
                swal('',"Please Enter PROFILE ID / MOBILE",'error');
                var isEmpty = false;
                return false;
            }
            if (pwd == '') {
                swal('',"Please Enter Password",'error');
                var isEmpty = false;
                return false;
            }
            var formdata = {'username': username, 'pwd': pwd };
            var url = base_url + "Login/getloginalert";
            $.ajax({url: url, data: formdata, type: "POST", async: false,  dataType : "json", beforeSend: function () {
            }, success : function (data) { 
              
                $('#chkinp').val(data);

               }

         }); 
          
         var cinp = $("#chkinp").val();
         if(cinp == 1 )
         {
             $("#invprof").show();
             $("#invpass").hide();
             return false;

         }
         else
            if(cinp == 2)
            {
                swal('','Invalid Password','error');
                // $("#invpass").show();
                 $("#invprof").hide();
                return false;
            }
            else
                if(cinp == 4) 
                {
                    swal('','Your Profile is in Inactive status','error');
                    return false;
                }else
                if(cinp == 5) 
                {
                    swal('','Your Profile Was Deactivated','error');
                    return false;
                }else
                if(cinp == 6) 
                {
                    swal('','Your Profile Was On Hold','error');
                    return false;
                }else
                if(cinp == 7) 
                {
                    swal('','Your Profile Was Deleted','error');
                    return false;
                }else
                if(cinp == 8) 
                {
                    swal('','Invalid Profile / Mobile number','error');
                    return false;
                }else
                if(cinp == 3) 
                {
                    $("#invpass").hide();
                    $("#invprof").hide();
                    return true;
                }

           
            
    }
    function intervalfnreq() {

        if (parseInt($("#profile_requestotpcount").html()) != 0)
            $("#profile_requestotpcount").html(parseInt($("#profile_requestotpcount").html()) - 1);


        else {
            var url = $("#profile_baseurl").val() + "Profile/expireOtp";
            var formdata = { "regid": $("#profile_registerid").val(), "eotp": $("#profile_eotp").val(), "otp": $('#profile_otp').val() };
            $.ajax({
                url: url, data: formdata, type: "POST", complete: function (resp) {
                    // $("#reqresendpwd").show();
                    $("#profile_requestresendotp").show();
                    $('#forgototprequesterr').hide();
                    $("#profile_requestotpexpired").show();
                    $("#profile_requestotpcount").hide();
                    $("#sec_count").hide();
                    $("#profile_eotp").val("");
                    $("#profile_otp").val("");

                    window.clearInterval(itrval);
                    itrval = false;
                }
            });
        }
    }


    function alertmsg(text) {
        //alert('k');
        document.getElementById("snackbar").innerHTML = text;
        var x = document.getElementById("snackbar");
        x.className = "show";
        setTimeout(function () { x.className = x.className.replace("show", ""); }, 2000);
    }
    $(document).ready(function () {

       
        $("#loginwithotp1").click(function () {

            // hide forgot pwd container after login clicked added by Surajit
            
            $("#pwdContainer").hide();
            $("#buttons").removeClass("mt-4");
            $("#buttons").addClass("mt-1");


            var username = $('#username').val();
            //$('#username').val('');
            $("#pwd").hide();
            $("#passworddis").css("display", "none");
            $(".cont-hide").css("display", "none");
            $("#submit").hide();
            $("#clear").hide();
            $("#otpsubmit").show();
            $("#loginwithotp1").hide();
            $("#backbtn_main").show();
            $("#profile_requestotpcount").hide();
            $("#sec_count").hide();
            $("#profile_requestotpexpired").hide();

        });
        $("#backbtn_main").click(function () {

            // show forgot pwd container after login clicked added by Surajit

            $("#pwdContainer").show();
            $("#buttons").removeClass("mt-1");
            $("#buttons").addClass("mt-4");

            var username = $('#username').val();
            $("#pwd").show();
            $("#passworddis").css("display", "block");
            $(".cont-hide").css("display", "block");
            $("#submit").show();
            $("#clear").show();
            $("#otpsubmit").hide();
            $("#loginwithotp1").show();
            $("#backbtn_main").hide();
            $("#profile_requestotpcount").hide();
            $("#sec_count").hide();
            $("#profile_requestotpexpired").hide();
            $('#otpsubmit_new').hide();
            $('#otppassworddis').hide();
            $('#username').val('');
            $('#request_otp').val('');


        });

        $('#forgotusererr').hide();
        $('#setnewpassworderr').hide();
     

        $("#forgot_otp").change(function(){
            var profileotp = $('#profile_otp').val();
            var forgototp = $('#forgot_otp').val();
            if((profileotp.trim() == forgototp) && (forgototp != ''))
            {
                $('#profile_otpcount_login').hide();
                $("#sec_count1").hide();
                $("#profile_otpexpired").hide();
                $("#profile_resendotp").hide();
                $('#forgototperr').show();
                $('#forgototperr').text("OTP Verified Successfully");
                $('#forgototperr').css("color", "green");
                $('#forgototperr').show();
                window.clearInterval(itrval);
                itrval = false;

            }
            else
            {
                 $('#forgototperr').show();
                $('#forgototperr').text("Please Enter Correct OTP");
                 $('#forgototperr').css("color", "green");
                $('#forgototperr').show();
            }

        });
        $("#otpsub").click(function () {
           

            var profileotp = $('#profile_otp').val();
            var forgototp = $('#forgot_otp').val();
            var username = $('#forgot_username').val();
            var regid = $('#profile_registerid').val();
            var pwd = $('input[name="setnewpassword"]').val();

           
            var regex = new RegExp("^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[!@#\$%\^&\*])(?=.{6,})");
            if (!regex.test(pwd) ) {
             $('#regview_passworderr').show();
             return false;    
            }

            if ($('#forgot_username').val().trim() == '') {
                $('#forgotusererr').show();
                return false;
            }
            else {
                $('#forgotusererr').hide();
            }
            if ($('#forgot_otp').val().trim() == '') {

                $('#forgototperr').show();
                return false;
            } else {
                $('#forgototperr').hide();
            }
            if ($('input[name="setnewpassword"]').val().trim() == '' || $('input[name="setnewpassword"]').val().length < 6) {
                $('#setnewpassworderr').show();
                return false;
            } else {
                $('#setnewpassworderr').hide();
            }
           
            if (profileotp.trim() == forgototp) {

                $('input[name="profile_resendotp"]').hide();
                $.ajax({
                    type: 'POST',
                    url: base_url + 'Login/updatepassword',
                    data: { 'password': pwd, 'registerid': regid },
                    success: function (data) {
                        if (data == 1) {
                            swal("Password changed Successfully");
                            $('#forgot_username').val('');
                            $('#forgot_otp').val('');
                            $('#setnewpassword').val('');
                            $('#note').hide();
                            $('#forgatconta').hide();
                            $('#loginconta').show();
                            $('#profile_otpcount_login').hide();
                            $("#sec_count1").hide();
                            $("#profile_otpexpired").hide();
                            $("#profile_resendotp").hide();
                        }
                        else
                        if(data == 2)
                        {
                            alert("Please Try Another This password resembles Old Password");
                        }

                       

                        else {
                            alertmsg("password not changed");
                        }


                    },
                   

                });

            } else {
                alert("invalid OTP");

            }
            if (pwd == '') {
                alertmsg("password not changed");
                return false;
            }
          

        });
        $('#profile_resendotp').on('click', function () {

            var username = $('#forgot_username').val();
          
            var moblie = $("#profile_mobile").val();
            var registerid = $("#profile_registerid").val();
            $.ajax({
                type: 'POST',
                url: base_url + 'Profile/forgototp',
