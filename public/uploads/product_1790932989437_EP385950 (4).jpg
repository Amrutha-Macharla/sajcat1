    <style>
    /* Initially hide the logout dropdown */
        .dropdown-menu-logout {
            display: none;
            top: 150%;
            left: 0;
            z-index: 1000;
            background-color: #333;
            padding: 10px;
            border-radius: 5px;
        }

        /* Show the logout dropdown when hovering over the parent .mlogos */
        .mlogos:hover .dropdown-menu-logout {
            display: block;
        }

        /* Optional: Styling for the logout item */
        .dropdown-menu-logout .mlogout1 {
            text-decoration: none;
            color: white;
        }

        .dropdown-menu-logout .mlogout1:hover {
            background-color: #444; /* Hover effect */
        }

        /* Ensure the dropdown stays visible if hovering over it directly */
        .mlogos:hover .dropdown-menu-logout, 
        .dropdown-menu-logout:hover {
            display: block;
        }

        /* Banner Styles*/
        @media screen and (max-width: 480px) {
            #mobileBanner img {
                height: 40px !important;
                width: auto !important;
            }

            #mobileBanner span {
                font-size: 12px !important;
            }
        }

        /* Custom Checkbox Styles by Surajit */
        input[type="checkbox"]
        {
            margin-top: 8px;
            min-width: 24px;
            min-height: 24px;
            max-width: 24px;
            max-height: 24px;
            border-radius: 50px;
            background: linear-gradient(white, white) padding-box,
                        linear-gradient(to right top, #f93702, #fd6900, #fe9000, #fdb300, #f9d323) border-box;
            border: 2px solid transparent;
            appearance: none;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }

        input[type="checkbox"]:checked
        {
            /* background-image: linear-gradient(to right top, #0dcaf0, #0dcaf0, #0dcaf0, #0dcaf0, #0dcaf0); */
            background-image: linear-gradient(to right top, #f93702, #fd6900, #fe9000, #fdb300, #f9d323);
            border: none;
            animation: circleGrow 0.3s ease-out forwards;
        }

        input[type="checkbox"]:checked::after
        {
            content: '';
            position: absolute;
            top: 5px;
            left: 9px;
            min-width: 6px;
            min-height: 12px;
            max-width: 6px;
            max-height: 12px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg) scale(0);
            animation: tickGrow 0.3s ease-out forwards;
        }

        /* Custom Login Button Adjustment */
        .peLogin .mlogo a {
            background-color: #900c3d !important; /* Maroon theme */
            color: #ffffff !important;
            /* padding: 8px 22px; */
            border-radius: 50px; /* Pill shape */
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px; /* Space between icon and text */
            text-decoration: none;
            /* font-weight: 600; */
            font-size: 14px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(144, 12, 61, 0.2);
            min-width: 100px;
            border: 1px solid transparent;
        }

        .peLogin .mlogo a:hover {
            background-color: #ffffff !important;
            color: #900c3d !important;
            border: 1px solid #900c3d;
            transform: translateY(-2px);
        }

        .peLogin .mlogo a i {
            font-size: 16px;
            margin-bottom: 2px; /* Slight adjustment for font-awesome alignment */
        }

        /* Adjusting the container spacing */
        .peLogin {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 15px;
        }

        /* Fix for the language icon container next to it */
        #trsnsImg {
            display: flex;
            align-items: center;
        }

        @keyframes tickGrow
        {
            0%
            {
                transform: rotate(45deg) scale(0);
                opacity: 0;
            }
            50%
            {
                transform: rotate(45deg) scale(2);
                opacity: 0.8;
            }
            100%
            {
                transform: rotate(45deg) scale(1);
                opacity: 1;
            }
        }

        @keyframes circleGrow
        {
            0%
            {
                transform: scale(0);
                opacity: 0;
            }
            50%
            {
                transform: scale(2);
                opacity: 0.8;
            }
            100%
            {
                transform: scale(1);
                opacity: 1;
            }
        }
      

           .refer-popup {
                    position: fixed;
                    bottom: 95px;
                    left: 40px;
                    display: none;
                    z-index: 1000;
            }

            .refer-popup input {
              flex: 1;
              padding: 6px 10px;
              font-size: 14px;
              border: 1px solid #ccc;
              border-radius: 6px;
            }

            .refer-popup button:hover {
              background-color: #ffc107;
            }

            @keyframes fadeIn {
              from { opacity: 0; transform: translateY(10px); }
              to   { opacity: 1; transform: translateY(0); }
            }

            .pnamate:hover {
              transform: scale(1.05) !important;
            }

            .pulse-button {
                border-radius: 5px;
                animation: pulse 1.5s infinite;
                background-color: #900c3d;
                color: white;
                border: none;
                text-align: center;
                font-size: 15px;
                padding: 0px 4px;
                margin-top: -7px;
                font-weight: bold;
            }

            @keyframes pulse {
              0% { transform: scale(1); }
              50% { transform: scale(1.05); }
              100% { transform: scale(1); }
            }



            /* From Uiverse.io by iconicchandu */ 
        /* From Uiverse.io by iconicchandu */ 
        .refcard {
          --white: hsl(0, 0%, 100%);
          /*--black: hsl(240, 15%, 9%);*/
          --paragraph: hsl(0, 0%, 83%);
          --line: hsl(240, 9%, 17%);
          --primary: hsl(189, 92%, 58%);

          position: relative;

          display: flex;
          flex-direction: column;
          gap: 1rem;

          padding: 1rem;
          width: 25rem;
        

          border-radius: 1rem;
          box-shadow: 0px -16px 24px 0px rgba(255, 255, 255, 0.25) inset;
          background: white;
        }

        .refcard .card__border {
          overflow: hidden;
          pointer-events: none;

          position: absolute;
          z-index: -10;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          width: calc(101% + 2.5px);
          height: calc(100% + 2.5px);
           background-image: linear-gradient(
            0deg,
            hsl(0, 0%, 100%) -50%,
            hsl(0, 0%, 40%) 100%
          ); 

          border-radius: 1rem;
        }


        .refcard .card__border::before {
          content: "";
          pointer-events: none;

          position: fixed;
          z-index: 200;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%), rotate(0deg);
          transform-origin: left;

          width: 200%;
          height: 10rem;
          background-image: linear-gradient(
            0deg,
            hsla(0, 0%, 100%, 0) 0%,
            #ffc107,
            #900c3d,
            hsla(0, 0%, 40%, 0) 100%
          );

          animation: rotate 8s linear infinite;
        }

        @keyframes rotate {
          to {
            transform: rotate(360deg);
          }
        }

        .refcard .card_title__container .card_title {
          font-size: 1rem;
          color: var(--white);
        }

        .refcard .card_title__container .card_paragraph {
            color: black;
            line-height: unset;
            font-family: fangsong;
            font-size: small;
        }

        .refcard .line {
          width: 100%;
          height: 0.1rem;
          background-color: var(--line);

          border: none;
        }

        .card .card__list {
          display: flex;
          flex-direction: column;
          gap: 0.5rem;
        }

        .refcard .card__list .card__list_item {
          display: flex;
          align-items: center;
          gap: 0.5rem;
        }

        .refcard .card__list .card__list_item .check {
          display: flex;
          justify-content: center;
          align-items: center;

          width: 1rem;
          height: 1rem;
          background-color: #f5df4e;

          border-radius: 50%;
        }

        .card .card__list .card__list_item .check .check_svg {
          width: 0.75rem;
          height: 0.75rem;

          fill: var(--black);
        }

        .refcard .card__list .card__list_item .list_text {
          font-size: 0.75rem;
          color: var(--white);
        }

        .refcard .button {
            cursor: pointer;
            padding: -0.5rem;
            width: 70%;
            /* background-image: linear-gradient(0deg, hsl(189, 92%, 58%), hsl(189, 99%, 26%) 100%); */
            color: var(--white);
            border: 0;
            border-radius: 9999px;
            /* box-shadow: inset 0 -2px 25px -4px var(--white); */
            background: #900c3d;
            font-family: cursive;
            font-size: 14px;
            font-weight: 700;
            margin: 2px;

        }



    </style>

    <style>
   /* Main chat box */
        .Pchat-Box {
            position: fixed;
            right: 20px;
            width: 360px;
            z-index: 9999;
            font-family: "Inter", "Segoe UI", sans-serif;
            border-radius: 15px;
            background: bottom;
        }

        /* Card look */
        .pchat-card {
            background: #ffffff;
            border-radius: 18px;
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.15);
            overflow: hidden;
        }

        /* Header */
        .PchatHeader {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            background: #900c3d;
        }

        .PchatHeader h6 {
            margin: 0;
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        /* Close button */
        .PchatHeader .btn-close {
            filter: invert(1);
            opacity: 0.8;
        }

        /* Form wrapper */
        .PchatForm1 {
            padding: 0px;
        }

        /* Remove default bootstrap form look */
        #hcform {
            padding: 15px;
            box-sizing: border-box;
        }

        #hcform input,
        #hcform textarea {
            width: 100%;
            box-sizing: border-box;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            padding: 14px 14px;
            font-size: 14px;
            margin-bottom: 12px !important;
            transition: all 0.25s ease;
        }


        /* Textarea */
        .chatTarea {
            resize: none;
        }

        /* Error label */
        .inputerr {
            font-size: 12px;
            margin-bottom: 8px;
        }

        /* Submit button */
        #hcsubmit.btn {
            /*width: 100%;*/
            border: none;
            border-radius: 12px;
            background: #900c3d;
            color: white;
            margin-bottom: 15px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        #hcsubmit.btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 25px rgba(79, 70, 229, 0.35);
        }

        /* Success message */
        #resText {
            font-size: 13px;
            color: #059669;
        }
            
            .Pchat-Box {
            animation-name: from-right;
        }

        /* Smooth open/close animation */
        .Pchat-Box {
            animation-duration: 0.4s;
            animation-fill-mode: both;
            animation-timing-function: ease-in-out;
        }

        @keyframes from-right {
            from { transform: translateX(120%); opacity: 0; }
            to   { transform: translateX(0); opacity: 1; }
        }

        @keyframes from-left {
            from { transform: translateX(-120%); opacity: 0; }
            to   { transform: translateX(0); opacity: 1; }
        }

        @keyframes from-bottom {
            from { transform: translateY(120%); opacity: 0; }
            to   { transform: translateY(0); opacity: 1; }
        }

        @keyframes from-top {
            from { transform: translateY(-120%); opacity: 0; }
            to   { transform: translateY(0); opacity: 1; }
        }

        /* =========================
           RESPONSIVE DESIGN
           ========================= */

        /* Default desktop already handled (360px) */

        /* Tablets */
        @media (max-width: 1024px) {
            .Pchat-Box {
                width: 340px;
                right: 15px;
            }
        }

        /* Large phones & small tablets */
        @media (max-width: 768px) {
            .Pchat-Box {
                width: 90%;
                max-width: 420px;
                right: 50%;
                transform: translateX(50%);
            }
        }

        /* Mobile phones */
        @media (max-width: 480px) {
            .Pchat-Box {
                animation-name: from-bottom;
            }
        }

        @media (max-width: 480px) {

            .Pchat-Box {
                width: 100%;

                height: auto;
                max-height: 65vh;      /* 👈 reduced overall height */
                padding: 8px;

                border-radius: 16px 16px 0 0;
                overflow: hidden;     /* keep card clean */
                right: auto;
            }

            .PchatForm1 {
                height: auto;
                max-height: 58vh;     /* 👈 inner height reduced */
                padding: 8px;
                overflow-y: auto;    /* scroll only if needed */
            }

            .pchat-card {
                border-radius: 16px 16px 0 0;
            }

            .PchatHeader {
                padding: 10px 14px;
            }

            #hcform {
                padding: 8px;
            }

            #hcform input,
            #hcform textarea {
                padding: 11px;
                font-size: 13px;
                margin-bottom: 8px;
            }

            #hcsubmit.btn {
                width: 100%;
                padding: 10px;
            }
        }

        /* Very small devices */
        @media (max-width: 360px) {
            #hcform input,
            #hcform textarea {
                font-size: 13px;
                padding: 12px;
            }
        }

         /* Logout Button */
          .peLogin {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
        }

        .mlogos {
            position: relative;
        }

        .logout-menu {
            position: absolute !important;
            top: 10%;
            min-width: max-content;
            background: #111;
            border-radius: 8px;
            padding: 6px;
            left: 75px;
        }

        .mlogout1 {
            white-space: nowrap;
        }
                .logout-wrapper {
            position: relative;
        }


        .logout-menu.show {
            display: block;
            opacity: 1;
        }


        /* PANEL */
        .notif-panel {
            display: none;
            top: 60px;
            right: 10px;
            width: 380px;
            max-height: 420px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            overflow: hidden;
            z-index: 9999;
            animation: fadeIn 0.2s ease-in-out;
        }

        /* HEADER */
        .notif-header {
            padding: 12px 15px;
            font-weight: bold;
            background: #f5f7fa;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .close-btn {
            cursor: pointer;
            font-size: 14px;
        }

        /* BODY */
        .notif-body {
            max-height: 360px;
            overflow-y: auto;
        }

        /* ITEM */
        .notif-item {
            padding: 12px 15px;
            border-bottom: 2px solid #f1f1f1;
            transition: background 0.2s;
            cursor: pointer;
            box-sizing: initial;
            border-radius: 20px;
            box-shadow: 2px 2px 5px 0px #ffc10796;
            margin: 10px;
        }

        .notif-item:hover {
            background: #f9f9f9;
        }

        /* UNREAD */
        .notif-item.unread {
            background: #eef5ff;
            font-weight: 500;
        }

        /* TEXT */
        .notif-text {
            font-size: 14px;
            color: #333;
        }

        /* TIME */
        .notif-time {
            font-size: 11px;
            color: #888;
            margin-top: 3px;
        }

        /* ANIMATION */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px);}
            to { opacity: 1; transform: translateY(0);}
        }
        
  /* ========================================
   FIX: HAMBURGER MENU TO LEFT SIDE WITH WORKING DROPDOWN
   ======================================== */

/* ---------- BASE STYLES ---------- */
.navbar {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    justify-content: flex-start !important;
    padding: 10px 15px !important;
    position: relative !important;
    right: 0px !important;
    min-height: 60px !important;
}

/* Force hamburger to LEFT side */
.mob-navi {
    order: -1 !important;
    margin-right: 10px !important;
    margin-left: 0 !important;
    border: 2px solid #ffffff;
    padding: 8px 12px;
    border-radius: 4px;
    background: #910b3d;
    cursor: pointer;
    color: #fff;
    z-index: 999;
    display: none;
    /* Hidden by default on desktop */
}

.mob-navi .fa-bars {
    color: #ffffff;
    font-size: 22px;
}

/* ---------- MOBILE & TABLET (up to 999px) ---------- */
@media screen and (max-width: 999px) {
    /* Show hamburger */
    .mob-navi {
        display: block !important;
        position: relative !important;
        right: auto !important;
        top: auto !important;
        left: 0 !important;
        order: -1 !important;
        margin-right: 10px !important;
        margin-left: 0 !important;
        background: #910b3d !important;
        padding: 8px 12px !important;
        color: #fff !important;
        border: 2px solid #ffffff;
        border-radius: 4px;
        float: left !important;
    }
    
    .mob-navi .fa-bars {
        color: #fff;
        font-size: 22px;
    }
    
    /* Fix for navbar collapse - THIS IS THE KEY FIX */
    .navbar-collapse {
        display: none !important;
        width: 100% !important;
        flex-basis: 100% !important;
        order: 3 !important;
        position: relative !important;
        top: auto !important;
        left: auto !important;
        background: #910b3d !important;
        padding: 10px !important;
        border-radius: 0 0 8px 8px !important;
        margin-top: 5px !important;
        max-height: 80vh !important;
        overflow-y: auto !important;
    }
    
    /* When toggled - SHOW the menu */
    .navbar-collapse.show {
        display: block !important;
    }
    
    /* Fix for collapsing in progress */
    .navbar-collapse.collapsing {
        display: block !important;
        height: auto !important;
        transition: height 0.3s ease !important;
        overflow: hidden !important;
    }
    
    /* Logo/Brand should come after hamburger */
    .navbar-brand {
        order: 0 !important;
        margin-right: auto !important;
        margin-left: 0 !important;
    }
    
    /* Fix for dropdown menus inside */
    .navbar-nav {
        flex-direction: column !important;
        width: 100% !important;
    }
    
    .navbar-nav .nav-item {
        width: 100% !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    }
    
    .navbar-nav .nav-item:last-child {
        border-bottom: none !important;
    }
    
    .navbar-nav .nav-link {
        color: #ffffff !important;
        padding: 10px 15px !important;
        display: block !important;
        width: 100% !important;
    }
    
    .navbar-nav .nav-link:hover {
        background: rgba(255, 255, 255, 0.1) !important;
        border-radius: 4px !important;
    }
    
    /* Fix for dropdown toggles */
    .dropdown-toggle::after {
        float: right !important;
        margin-top: 8px !important;
    }
    
    .dropdown-menu {
        position: relative !important;
        width: 100% !important;
        background: rgba(255, 255, 255, 0.95) !important;
        border: none !important;
        border-radius: 4px !important;
        padding: 5px 0 !important;
        margin: 5px 0 !important;
        box-shadow: none !important;
    }
    
    .dropdown-menu .dropdown-item {
        color: #333 !important;
        padding: 8px 20px !important;
    }
    
    .dropdown-menu .dropdown-item:hover {
        background: #910b3d !important;
        color: #fff !important;
    }
}

/* ---------- DESKTOP (1000px and above) ---------- */
@media screen and (min-width: 1000px) {
    .mob-navi {
        display: none !important;
    }
    
    .navbar-collapse {
        display: flex !important;
    }
}

/* ---------- RESPONSIVE SIZES ---------- */
@media screen and (max-width: 374px) {
    .mob-navi {
        padding: 4px 8px !important;
        margin-right: 6px !important;
    }
    .mob-navi .fa-bars {
        font-size: 14px !important;
    }
}

@media screen and (min-width: 375px) and (max-width: 576px) {
    .mob-navi {
        padding: 6px 10px !important;
        margin-right: 8px !important;
    }
    .mob-navi .fa-bars {
        font-size: 18px !important;
    }
}

@media screen and (min-width: 577px) and (max-width: 991px) {
    .mob-navi {
        padding: 8px 12px !important;
        margin-right: 12px !important;
    }
    .mob-navi .fa-bars {
        font-size: 22px !important;
    }
}

@media screen and (min-width: 992px) and (max-width: 999px) {
    .mob-navi {
        padding: 10px 15px !important;
        margin-right: 15px !important;
    }
    .mob-navi .fa-bars {
        font-size: 24px !important;
    }
}

    </style>
    <script>
        // disable right click
        document.addEventListener('contextmenu', event => event.preventDefault());
        // $(document).on("contextmenu",function(e)
        // {        
        //     e.preventDefault();
        // });
        document.onkeydown = function (e) 
        {

            // disable F12 key
            if(e.keyCode == 123) {
                return false;
            }

            // disable I key for winddows
            if(e.ctrlKey && e.shiftKey && e.keyCode == 73)
            {
                return false;
            }
            // disable I key for mac
            if(e.keyCode == 18 && e.keyCode == 93 && e.keyCode == 73)
            {
                return false;
            }
            // disable I key for mac
            if(e.keyCode == 18 && e.keyCode == 91 && e.keyCode == 73)
            {
                return false;
            }

            // disable J key
            if(e.ctrlKey && e.shiftKey && e.keyCode == 74) 
            {
                return false;
            }

            // disable U key
            if(e.ctrlKey && e.keyCode == 85) 
            {
                return false;
            }
        }
    </script>

