const translateBtn = document.getElementById('translate');
const translateMenu = document.getElementById('translates');

// Toggle dropdown when clicking anywhere in #translate
translateBtn.addEventListener('click', function(e) {
    e.stopPropagation(); // prevent closing immediately
    if(translateMenu.style.display === 'block'){
        translateMenu.style.display = 'none';
    } else {
        translateMenu.style.display = 'block';
    }
});

// Close dropdown if clicking outside
document.addEventListener('click', function() {
    translateMenu.style.display = 'none';
});

$(document).on('shown.bs.tab', 'a[data-toggle="tab"]', function (e) {
    // This keeps the URL as /membership-plans/ even when tabs change
    const baseUrl = 'https://www.eenadupellipandiri.net/membership-plans/';
    history.replaceState(null, '', baseUrl);
});

