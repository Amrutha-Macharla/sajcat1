		$("#hideprofileform").submit(function (event) {
			event.preventDefault();
			var MEMID = $('#MEMID').val();
			var TYPE = $('#STYPE').val();
			var SP = '';
			$('#hideprofileform input[type=radio]').each(function () {
				if ($("#" + this.id).prop("checked") == true) {
					SP = this.value;

				}
			});
			var formdata = { 'MEMID': MEMID, 'TYPE': TYPE, 'SP': SP };
			var url = base_url + "Login/hide_unhide_profile";
			$.ajax({
				url: url, data: formdata, type: 'POST', beforeSend: function () {
					$("body").addClass("loading");
				}, success: function (resp) {

					if (resp.trim() == 1 && TYPE == 'hide') {
						swal("Profile protected Successfully ?");
						window.location.href = base_url + "Login/deleteprofile"; 
					}
					if (resp.trim() == 11 && TYPE == 'hide') {
						swal("Profile already in protected mode");
						window.location.href = base_url + "Login/deleteprofile"; 
					}
					if (resp.trim() == 2 && TYPE == 'unhide') {
						window.location.href = base_url + "Login/deleteprofile"; 
					}
					if (resp.trim() == 22 && TYPE == 'unhide') {
						window.location.href = base_url + "Login/deleteprofile"; 
					}
					if (resp.trim() == 3) {
						swal("Something wetn wrong");
						window.location.href = base_url + "Login/deleteprofile"; 
					}

					$("body").removeClass("loading");
				}
			});
		});




		// Added by Surajit for Print Profile
		function print_Profile() {
			var divName = "myProprint";
			var printContents = document.getElementById(divName).innerHTML;
			var originalContents = document.body.innerHTML;

			document.body.innerHTML = printContents;

			window.print();

			document.body.innerHTML = originalContents;
		}



		//Added by Surajit for setting matching criteria
		document.addEventListener("DOMContentLoaded", () => {
			var mctbl = document.getElementById("mctbl");
			mcc = mctbl.getElementsByClassName("fa fa-check-circle").length
			document.getElementById("matchr").innerText = `${mcc} / 10`;
		});

		// Added by Surajit for Dowload image
		function downloadhoro(url) {
			// alert(url);
			// preventDefault();
			fetch(url, {
				mode: 'no-cors',
			})
				.then(response => response.blob())
				.then(blob => {
					let blobUrl = window.URL.createObjectURL(blob);
					let a = document.createElement('a');
					a.download = url.replace(/^.*[\\\/]/, '');
					a.href = blobUrl;
					document.body.appendChild(a);
					a.click();
					a.remove();
				})
		} 

		function downloadphoto(url) {
			fetch(url, {
				mode: 'no-cors',
			})
				.then(response => response.blob())
				.then(blob => {
					let blobUrl = window.URL.createObjectURL(blob);
					let a = document.createElement('a');
					a.download = url.replace(/^.*[\\\/]/, '');
					a.href = blobUrl;
					document.body.appendChild(a);
					a.click();
					a.remove();
				})
		} 
		function safeBack() {
			if (document.referrer && document.referrer !== window.location.href) {
				window.location = document.referrer;
			} else {
				// window.location.href = "https://www.eenadupellipandiri.net/splpackages/home-tab";
				window.location.reload();
			}
		}

		function confirmAndRedirectToSplpackages(url) {
			swal({
				title: 'Kindly Upgrade Your Membership To Send The Request',
				// text: 'To Send The Request',
				icon: 'warning',
				buttons: true,
				dangerMode: false,
			}).then((willGo) => {
				if (willGo) {
					window.location.href = 'https://www.eenadupellipandiri.net/splpackages/home-tab';
				}
			});
		}

	</script>
